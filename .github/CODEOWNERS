# Requests reviewers automatically. Without branch protection this is a prompt, not
# a gate. Later rules win, so the narrow entries below override the catch-all.

*                                @your-github-handle

# Anything that decides what reaches production deserves a deliberate look.
/.github/                        @your-github-handle
/.gitleaks.toml                  @your-github-handle
/Dockerfile                      @your-github-handle
/.dockerignore                   @your-github-handle

# The agent's guardrails: what it may run and reach, what it is refused, and the
# checks and unlock scripts that prove and open them.
/.claude/hooks/                  @your-github-handle
/.claude/settings.json           @your-github-handle
/.claude/agent-config.json       @your-github-handle
/.mcp.json                       @your-github-handle
/.husky/                         @your-github-handle
/scripts/check/                  @your-github-handle
/scripts/ops/                    @your-github-handle
/scripts/env/                    @your-github-handle
/.skillspector-baseline.yaml     @your-github-handle

# The composition root, the env schema, and the one real connection pool: a
# mistake in any of these breaks startup or serializes every request.
/src/app.ts                      @your-github-handle
/src/env.ts                      @your-github-handle
/src/db/client/index.ts          @your-github-handle

# drizzle-kit generated — never hand-edited.
/src/db/migrations/              @your-github-handle
