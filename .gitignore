# Agent-local state — never commit
.claude/settings.local.json
.claude/session-logs/
# Unlock files, .env backups (they hold secrets) and the audit log — docs/unlock.md
.claude/state/
.serena/
# SkillSpector reports (scripts/check/skills.sh)
.skillspector/

# Secrets: every env file; the .example templates are committed
.env
.env.*
.envrc
!.env.example
!.env.*.example

# Dependencies, build and test output
node_modules/
dist/
build/
/coverage

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
bun-debug.log*

# System and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
